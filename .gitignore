# ───────────────────────────────────────────────
# 🔐 GÜVENLİK — ASLA GITHUB'A GİTMEMELİ
# ───────────────────────────────────────────────

# Ortam değişkenleri ve gizli bilgiler
.env
.env.*
*.env
secrets.yml
secrets.yaml
secrets.properties

# JWT secret, DB şifresi gibi hassas config dosyaları
application-prod.yml
application-prod.properties
application-local.yml
application-local.properties
application-secret.yml

# Google / Firebase servis hesabı anahtarları
google-services.json
GoogleService-Info.plist
firebase-adminsdk*.json
serviceAccountKey.json
*.keystore
*.jks
*.p12
*.pfx
key.properties


# ───────────────────────────────────────────────
# ☕ JAVA / MAVEN (Backend)
# ───────────────────────────────────────────────

# Derleme çıktıları
target/
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# Maven wrapper
.mvn/wrapper/maven-wrapper.properties

# IDE dosyaları
*.class
*.jar
*.war
*.ear
*.nar
hs_err_pid*
replay_pid*


# ───────────────────────────────────────────────
