# ───────────────────────────────────────────────

# Gradle build çıktıları
.gradle/
build/
mobile/build/
mobile/.gradle/
mobile/app/build/

# Local config (makine spesifik)
local.properties
mobile/local.properties

# Gradle Wrapper (jar hariç)
!gradle/wrapper/gradle-wrapper.jar
!**/gradle/wrapper/gradle-wrapper.jar

# Android Keystore (imzalama anahtarı — KESİNLİKLE commit edilmemeli)
*.keystore
*.jks
release.keystore
debug.keystore

# Android profiling
*.hprof


